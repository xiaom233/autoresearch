# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
worktrees/
results/
queue/

# Agent prompt files (generated per-session by launchers)
AGENTS.md

# Resource directory — keep code only, exclude data/models
resource/*/dfpir_blind/
resource/*/logs_train/
resource/*/checkpoints/
resource/AI-Scientist-v2/
resource/CSEC/
resource/SFHformer/
resource/X-Restormer/
resource/*/README.md
resource/*/data_dir/
resource/*/test_3D_DFPIR.py
resource/*/test_5D_DFPIR.py
resource/*/train_3D_DFPIR.py
resource/*/train_5D_DFPIR.py
resource/*/utils/

# Experimental code/artifacts
dev/
exp*/
logs/

# Results file
results.tsv

# Blind challenge artifacts (generated, must not leak ground truth)
blind_challenge/
.ground_truth.json

# Large files (checkpoints, logs, images)
*.pt
*.pth
*.log
*.png
*.jpg
*.tar
*.ipynb
datasets/

# .claude — keep skills, exclude everything else
.claude/*
!.claude/skills
.claude/skills/**/__pycache__/

# Resource checkpoints and logs (keep code only)
resource/*/dfpir_blind/
resource/*/logs_train/
resource/*/checkpoints/

# IDE
.idea/resource/AI-Scientist-v2/
.gt_mappings/
